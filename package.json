    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "react-grab": "0.0.80",
    "react-scan": "0.4.2",
